kelelega.dpdns.org {
	# 支持多用户：AUTH_USERS 是空格分隔的“用户名 哈希”对，可写多个用户。
	# Caddy 认证成功后由反代注入可信身份头，后端不接受浏览器自行提交的用户参数。
	basic_auth {
		{$AUTH_USERS}
	}

	# 日历设置 API 与 iCal 读取共用同源路径，Caddy 注入当前登录用户。
	handle_path /calendar/* {
		reverse_proxy ical-proxy:8089 {
			header_up X-Authenticated-User {http.auth.user.id}
		}
	}

	handle_path /fund-monitor/* {
		reverse_proxy fund-monitor:8090 {
			header_up X-Authenticated-User {http.auth.user.id}
		}
	}

	handle {
		reverse_proxy homepage:3000 {
			header_up X-Authenticated-User {http.auth.user.id}
		}
	}
}
